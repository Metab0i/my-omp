# ~/.omp: version the harness configuration, never runtime state.
# Whitelist by default: caches, logs, databases (auth secrets), sessions,
# profiles, updates and installed plugin code stay ignored.
*
!.gitignore
!README.md
!marketplaces.json

!agent/
!agent/AGENTS.md
!agent/config.yml
!agent/mcp.json
!agent/skills.lock.json
!agent/skills/
!agent/skills/**
!agent/extensions/
!agent/extensions/**

!plugins/
!plugins/package.json
!plugins/bun.lock
!plugins/omp-plugins.lock.json
!plugins/installed_plugins.json

# Named profiles: configuration only, never their databases, sessions or caches.
!profiles/
!profiles/*/
!profiles/*/agent/
!profiles/*/agent/AGENTS.md
!profiles/*/agent/config.yml
!profiles/*/agent/mcp.json
!profiles/*/agent/skills.lock.json
!profiles/*/agent/skills/
!profiles/*/agent/skills/**
!profiles/*/agent/extensions/
!profiles/*/agent/extensions/**
